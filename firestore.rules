rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // English Game Lab never exposes Firestore directly to students or the browser.
    // All access goes through the authenticated Cloud Function API (Admin SDK).
    // This keeps real student names and answer keys server-side.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Example for a NEW Firebase project. Never copy real teacher credentials.
# This file is documentation: it is NOT used by the published school instance.
EGL_BOOTSTRAP_TEACHER_EMAIL=teacher@example.org
EGL_BOOTSTRAP_TEACHER_USERNAME=teacher
EGL_STUDENT_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
EGL_AUDIO_BUCKET=your-firebase-project.firebasestorage.app
